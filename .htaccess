<IfModule mod_rewrite.c>
    RewriteEngine On
    # Cegah akses langsung ke file sensitif
    RewriteRule ^(\.env|composer\.(json|lock)|schema\.sql|README\.md) - [F,L,NC]
    
    # Arahkan semua request ke folder public/
    RewriteRule ^$ public/ [L]
    RewriteRule (.*) public/$1 [L]
</IfModule>
